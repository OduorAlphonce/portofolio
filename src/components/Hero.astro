---
const EMAIL = 'alphonceoyungaoduor@gmail.com';
---

<section id="top" class="reveal mx-auto max-w-4xl px-6 pb-16 pt-14 sm:pt-20">
  <div class="flex flex-col-reverse items-start gap-10 sm:flex-row sm:items-center sm:justify-between sm:gap-16">
    <div class="flex max-w-xl flex-col items-start gap-6">
      <h1 class="text-3xl font-semibold tracking-tight text-[var(--color-text)] sm:text-4xl">
        Hi, I'm Alphonce Oyunga — a backend engineer who also leads teams and ships full products
        end to end.
      </h1>
      <p class="text-lg text-[var(--color-text-muted)]">
        I build the systems that hold up when things get messy: auth, pricing logic, offline sync.
      </p>
      <a
        href={`mailto:${EMAIL}`}
        class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-5 py-2.5 text-sm font-medium text-white transition-transform hover:scale-[1.02]"
      >
        Email me
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <path d="M5 12h14M13 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <img
      src="/photo.jpg"
      alt="Portrait of Alphonce Oyunga"
      class="h-48 w-48 shrink-0 rounded-2xl border border-[var(--color-border)] object-cover sm:h-72 sm:w-72"
      onerror="this.style.display='none'"
    />
  </div>
</section>