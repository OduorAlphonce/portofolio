---
const links = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Work' },
  { href: '#articles', label: 'Articles' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur">
  <div class="flex w-full items-center justify-between gap-4 px-6 py-3 sm:px-10 lg:px-16">
    <a
      href="#top"
      class="flex flex-col items-start gap-1.5 rounded-xl border border-[var(--color-border)] px-3 py-2 transition-colors hover:border-[var(--color-accent)]"
    >
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[var(--color-accent)] text-[11px] font-bold text-black">
        AO
      </span>
      <span class="text-sm font-semibold leading-none tracking-tight text-[var(--color-text)]">
        Alphonce Oyunga
      </span>
    </a>
    <nav class="hidden items-center gap-6 sm:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>