---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Work' },
  { href: '#articles', label: 'Articles' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="#top" class="text-sm font-semibold tracking-tight text-[var(--color-text)]">
      Alphonce Oyunga
    </a>
    <nav class="hidden items-center gap-6 sm:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>
