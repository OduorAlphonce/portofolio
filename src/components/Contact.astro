---
const EMAIL = 'alphonceoyungaoduor@gmail.com';
---

<section id="contact" class="reveal mx-auto max-w-3xl px-6 py-20 text-center">
  <h2 class="text-2xl font-semibold text-[var(--color-text)] sm:text-3xl">
    Looking for a backend, PM, or fullstack contributor?
  </h2>
  <p class="mt-2 text-[var(--color-text-muted)]">I'd rather talk than have you guess.</p>
  <a
    href={`mailto:${EMAIL}`}
    class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-medium text-white transition-transform hover:scale-[1.02]"
  >
    Email me directly
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
      <path d="M5 12h14M13 5l7 7-7 7"></path>
    </svg>
  </a>
</section>
